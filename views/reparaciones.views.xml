<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="view_reparaciones_list" model="ir.ui.view">
        <field name="name">taller.reparaciones.list</field>
        <field name="model">taller.reparacion</field>
        <field name="arch" type="xml">
            <list>
                <field name="referencia"/>
                <field name="maquina"/>
                <field name="responsable"/>
                <field name="fecha_inicio"/>
                <field name="estado" widget="badge" decoration-success="estado == 'terminada'" decoration-warning="estado == 'pendiente'" decoration-info="estado == 'en_proceso'"/>
                <field name="costo" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_reparaciones_form" model="ir.ui.view">
        <field name="name">taller.reparaciones.form</field>
        <field name="model">taller.reparacion</field>
        <field name="arch" type="xml">
            <form string="Reparaciones">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="referencia" placeholder="Numero de reparacion..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="maquina" options="{'no_create': True}"/>
                            <field name="responsable" options="{'no_create': True}"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                        <group>
                            <field name="estado"/>
                            <field name="costo"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcion"/>
                        <field name="notas"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_reparaciones" model="ir.actions.act_window">
        <field name="name">Reparaciones</field>
        <field name="res_model">taller.reparacion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera reparacion!
            </p>
        </field>
    </record>
</odoo>